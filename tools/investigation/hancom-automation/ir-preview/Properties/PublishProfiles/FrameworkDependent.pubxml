<Project>
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <UseAppHost>true</UseAppHost>
    <RollForward>LatestPatch</RollForward>
    <AppHostDotNetSearch>EnvironmentVariable</AppHostDotNetSearch>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishDir>bin/$(Configuration)/net10.0-windows/win-x64/publish/</PublishDir>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(MSBuildProjectDirectory)/../../../../tests/fixtures/templates/minimal-tagged-v1.hwp"
             Link="template.hwp" TargetPath="template.hwp"
             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
