<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PlatformTarget>x64</PlatformTarget>
    <RestoreConfigFile>$(MSBuildThisFileDirectory)../ir-preview/NuGet.Config</RestoreConfigFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ir-preview/TemplateDeclarations.cs" Link="TemplateDeclarations.cs" />
    <Compile Include="../ir-preview/TemplateRangeStructure.cs" Link="TemplateRangeStructure.cs" />
    <None Include="../../../../tests/fixtures/template-declarations/*.txt" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
