{
  "schema": "md2hwp.ast2ir-rules",
  "target_ir": {
    "schema": "md2hwp.ir",
    "version": "0.4"
  },
  "unlisted_constructor": "reject",
  "document": {
    "metadata": "require_empty",
    "object_sources": {
      "separator": "space",
      "owners": [
        "figure",
        "verbatim_block",
        "table"
      ],
      "empty": "reject",
      "handler": "adjacent_paragraph",
      "prefixes": [
        "출처",
        "주",
        "주석",
        "참고",
        "자료",
        "설명",
        "비고",
        "단위",
        "기준",
        "해설",
        "약어",
        "참조",
        "주의",
        "작성",
        "제공",
        "재구성",
        "번역",
        "source",
        "src",
        "note",
        "annotation",
        "annot",
        "reference",
        "ref",
        "data",
        "description",
        "desc",
        "remark",
        "remarks",
        "unit",
        "basis",
        "commentary",
        "cmt",
        "abbreviation",
        "abbr",
        "credit",
        "translation",
        "trans"
      ],
      "numbered_prefixes": [
        "주",
        "주석",
        "note"
      ]
    }
  },
  "blocks": {
    "Para": {
      "handler": "paragraph",
      "figure": {
        "attributes": "optional_id_only",
        "context": "document_only",
        "handler": "standalone_image",
        "caption": "alt"
      }
    },
    "Figure": {
      "handler": "figure",
      "attributes": "optional_id_only",
      "caption": "single_paragraph",
      "content": "single_image"
    },
    "Header": {
      "handler": "heading",
      "minimum_level": 1,
      "maximum_level": 6,
      "attributes": "optional_id_only"
    },
    "Plain": {
      "handler": "list_item_paragraph",
      "context": "list_item_only"
    },
    "CodeBlock": {
      "handler": "verbatim_block",
      "attributes": "require_empty"
    },
    "BulletList": {
      "handler": "bullet_list"
    },
    "OrderedList": {
      "handler": "ordered_list",
      "minimum_start": 1,
      "number_styles": [
        "DefaultStyle",
        "Decimal"
      ],
      "delimiters": [
        "DefaultDelim",
        "Period",
        "OneParen"
      ]
    },
    "Table": {
      "handler": "table",
      "attributes": "require_empty"
    }
  },
  "inlines": {
    "Note": {
      "handler": "footnote"
    },
    "Str": {
      "handler": "text"
    },
    "Space": {
      "handler": "space"
    },
    "SoftBreak": {
      "handler": "space"
    },
    "LineBreak": {
      "handler": "line_break"
    },
    "Strong": {
      "handler": "strong"
    },
    "Emph": {
      "handler": "emph"
    },
    "Link": {
      "handler": "link",
      "attributes": "require_empty",
      "target": "require_nonempty",
      "absent_title": "null",
      "internal_target": "resolve_heading_or_figure"
    }
  }
}
