{
  "schema": "md2hwp.ast2ir-rules",
  "target_ir": {
    "schema": "md2hwp.ir",
    "version": "0.3"
  },
  "unlisted_constructor": "reject",
  "document": {
    "metadata": "require_empty",
    "object_sources": {
      "separator": "space",
      "prefix": "출처:",
      "owners": [
        "figure",
        "verbatim_block"
      ],
      "empty": "reject",
      "handler": "adjacent_paragraph"
    }
  },
  "blocks": {
    "Para": {
      "handler": "paragraph",
      "figure": {
        "attributes": "optional_id_only",
        "context": "document_only",
        "handler": "standalone_image",
        "caption": "alt"
      }
    },
    "Figure": {
      "handler": "figure",
      "attributes": "optional_id_only",
      "caption": "single_paragraph",
      "content": "single_image"
    },
    "Header": {
      "handler": "heading",
      "minimum_level": 1,
      "maximum_level": 6,
      "attributes": "optional_id_only"
    },
    "Plain": {
      "handler": "list_item_paragraph",
      "context": "list_item_only"
    },
    "CodeBlock": {
      "handler": "verbatim_block",
      "attributes": "require_empty"
    },
    "BulletList": {
      "handler": "bullet_list"
    },
    "OrderedList": {
      "handler": "ordered_list",
      "minimum_start": 1,
      "number_styles": [
        "DefaultStyle",
        "Decimal"
      ],
      "delimiters": [
        "DefaultDelim",
        "Period",
        "OneParen"
      ]
    }
  },
  "inlines": {
    "Note": {
      "handler": "footnote"
    },
    "Str": {
      "handler": "text"
    },
    "Space": {
      "handler": "space"
    },
    "SoftBreak": {
      "handler": "space"
    },
    "LineBreak": {
      "handler": "line_break"
    },
    "Strong": {
      "handler": "strong"
    },
    "Emph": {
      "handler": "emph"
    },
    "Link": {
      "handler": "link",
      "attributes": "require_empty",
      "target": "require_nonempty",
      "absent_title": "null",
      "internal_target": "resolve_heading_or_figure"
    }
  }
}
