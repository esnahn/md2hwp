<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>0.4.1</Version>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>hwp2pdf</AssemblyName>
    <RestoreConfigFile>$(MSBuildProjectDirectory)/../../backends/hancom-automation/NuGet.Config</RestoreConfigFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../backends/hancom-automation/Md2Hwp.Backend.csproj" />
  </ItemGroup>
</Project>
