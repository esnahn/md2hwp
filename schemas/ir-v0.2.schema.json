{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:md2hwp:schema:ir:0.2",
  "title": "md2hwp project IR v0.2",
  "description": "Closed structural serialization contract for md2hwp IR version 0.2.",
  "$comment": "Human-readable string values must use Unicode NFC. Opaque link targets and image paths retain exact scalar values and are exempt. This semantic invariant is enforced by typed validation because JSON Schema cannot express it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ir_version",
    "metadata",
    "blocks"
  ],
  "properties": {
    "schema": {
      "const": "md2hwp.ir"
    },
    "ir_version": {
      "const": "0.2"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      }
    }
  },
  "$defs": {
    "inline_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/inline"
      }
    },
    "inline_array_allow_empty": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inline"
      }
    },
    "block": {
      "oneOf": [
        {
          "$ref": "#/$defs/paragraph"
        },
        {
          "$ref": "#/$defs/heading"
        },
        {
          "$ref": "#/$defs/verbatim_block"
        },
        {
          "$ref": "#/$defs/list"
        },
        {
          "$ref": "#/$defs/figure"
        }
      ]
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "inlines"
      ],
      "properties": {
        "type": {
          "const": "paragraph"
        },
        "inlines": {
          "$ref": "#/$defs/inline_array"
        }
      }
    },
    "heading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "level",
        "inlines"
      ],
      "properties": {
        "type": {
          "const": "heading"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "inlines": {
          "$ref": "#/$defs/inline_array"
        }
      }
    },
    "verbatim_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "lines"
      ],
      "properties": {
        "type": {
          "const": "verbatim_block"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[^\\r\\n]*$",
            "not": {
              "pattern": "[\\u0000-\\u0008\\u000A-\\u001F\\u007F]"
            }
          }
        },
        "source": {
          "oneOf": [
            {
              "$ref": "#/$defs/inline_array"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "kind",
        "tight",
        "items"
      ],
      "properties": {
        "type": {
          "const": "list"
        },
        "kind": {
          "enum": [
            "bullet",
            "ordered"
          ]
        },
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "tight": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/list_item"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ordered"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "start"
            ]
          },
          "else": {
            "not": {
              "required": [
                "start"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "tight": {
                "const": true
              }
            },
            "required": [
              "tight"
            ]
          },
          "then": {
            "properties": {
              "items": {
                "items": {
                  "$ref": "#/$defs/list_item_tight"
                }
              }
            }
          }
        }
      ]
    },
    "list_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocks"
      ],
      "properties": {
        "blocks": {
          "type": "array",
          "minItems": 1,
          "prefixItems": [
            {
              "$ref": "#/$defs/paragraph"
            }
          ],
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/paragraph"
              },
              {
                "$ref": "#/$defs/list"
              }
            ]
          }
        }
      }
    },
    "list_item_tight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocks"
      ],
      "properties": {
        "blocks": {
          "type": "array",
          "minItems": 1,
          "prefixItems": [
            {
              "$ref": "#/$defs/paragraph"
            }
          ],
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/paragraph"
              },
              {
                "$ref": "#/$defs/list"
              }
            ]
          },
          "contains": {
            "$ref": "#/$defs/paragraph"
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "image",
        "caption",
        "source"
      ],
      "properties": {
        "type": {
          "const": "figure"
        },
        "image": {
          "$ref": "#/$defs/image_ref"
        },
        "caption": {
          "$ref": "#/$defs/inline_array"
        },
        "source": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/inline_array"
            }
          ]
        }
      }
    },
    "image_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "alt",
        "title"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "not": {
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
              }
            },
            {
              "not": {
                "pattern": "^/"
              }
            },
            {
              "not": {
                "pattern": "[\\\\\\u0000-\\u001F\\u007F]"
              }
            }
          ]
        },
        "alt": {
          "$ref": "#/$defs/inline_array_allow_empty"
        },
        "title": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "[\\u0000-\\u001F\\u007F]"
              }
            }
          ]
        }
      }
    },
    "inline": {
      "oneOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "$ref": "#/$defs/space"
        },
        {
          "$ref": "#/$defs/line_break"
        },
        {
          "$ref": "#/$defs/strong"
        },
        {
          "$ref": "#/$defs/emph"
        },
        {
          "$ref": "#/$defs/link"
        }
      ]
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^ \\r\\n]+$",
          "not": {
            "pattern": "[ \\u0000-\\u001F\\u007F]"
          }
        }
      }
    },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "space"
        }
      }
    },
    "line_break": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "line_break"
        }
      }
    },
    "strong": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "inlines"
      ],
      "properties": {
        "type": {
          "const": "strong"
        },
        "inlines": {
          "$ref": "#/$defs/inline_array"
        }
      }
    },
    "emph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "inlines"
      ],
      "properties": {
        "type": {
          "const": "emph"
        },
        "inlines": {
          "$ref": "#/$defs/inline_array"
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "target",
        "title",
        "inlines"
      ],
      "properties": {
        "type": {
          "const": "link"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "[\\u0000-\\u001F\\u007F]"
          }
        },
        "title": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "[\\u0000-\\u001F\\u007F]"
              }
            }
          ]
        },
        "inlines": {
          "$ref": "#/$defs/inline_array"
        }
      }
    }
  }
}
