{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:md2hwp:schema:ir:0.4",
  "title": "md2hwp project IR v0.4",
  "description": "Closed structural serialization contract for md2hwp IR version 0.4.",
  "$comment": "Human-readable string values must use Unicode NFC. Opaque link targets and image paths retain exact scalar values and are exempt. This semantic invariant is enforced by typed validation because JSON Schema cannot express it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ir_version",
    "metadata",
    "blocks"
  ],
  "properties": {
    "schema": {
      "const": "md2hwp.ir"
    },
    "ir_version": {
      "const": "0.4"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "subtitle": {
          "type": "string",
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "date": {
          "type": "string",
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "publisher": {
          "type": "string",
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "author": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
              }
            }
          ]
        },
        "date-meta": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "md2hwp-heading1-start": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "Reserved heading1 start number, from 1 to 2147483647; defaults to 1. Semantic validation checks the range and total chapter count."
        }
      },
      "patternProperties": {
        "^md2hwp-.+$": {
          "type": "string",
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        }
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      }
    }
  },
  "$defs": {
    "inline_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/inline"
      }
    },
    "inline_array_allow_empty": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inline"
      }
    },
    "block": {
      "oneOf": [
        {
          "$ref": "#/$defs/paragraph"
        },
        {
          "$ref": "#/$defs/heading"
        },
        {
          "$ref": "#/$defs/verbatim_block"
        },
        {
          "$ref": "#/$defs/list"
        },
        {
          "$ref": "#/$defs/figure"
        },
        {
          "$ref": "#/$defs/table"
        }
      ]
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "inlines"
      ],
      "properties": {
        "type": {
          "const": "paragraph"
        },
        "inlines": {
          "$ref": "#/$defs/inline_array"
        }
      }
    },
    "heading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "level",
        "inlines"
      ],
      "properties": {
        "type": {
          "const": "heading"
        },
        "id": {
          "$ref": "#/$defs/target_id"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "inlines": {
          "$ref": "#/$defs/inline_array"
        }
      }
    },
    "verbatim_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "lines"
      ],
      "properties": {
        "type": {
          "const": "verbatim_block"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[^\\r\\n]*$",
            "not": {
              "pattern": "[\\u0000-\\u0008\\u000A-\\u001F\\u007F]"
            }
          }
        },
        "source": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/source_paragraphs"
            }
          ]
        }
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "kind",
        "tight",
        "items"
      ],
      "properties": {
        "type": {
          "const": "list"
        },
        "kind": {
          "enum": [
            "bullet",
            "ordered"
          ]
        },
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "tight": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/list_item"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ordered"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "start"
            ]
          },
          "else": {
            "not": {
              "required": [
                "start"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "tight": {
                "const": true
              }
            },
            "required": [
              "tight"
            ]
          },
          "then": {
            "properties": {
              "items": {
                "items": {
                  "$ref": "#/$defs/list_item_tight"
                }
              }
            }
          }
        }
      ]
    },
    "list_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocks"
      ],
      "properties": {
        "blocks": {
          "type": "array",
          "minItems": 1,
          "prefixItems": [
            {
              "$ref": "#/$defs/paragraph"
            }
          ],
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/paragraph"
              },
              {
                "$ref": "#/$defs/list"
              }
            ]
          }
        }
      }
    },
    "list_item_tight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocks"
      ],
      "properties": {
        "blocks": {
          "type": "array",
          "minItems": 1,
          "prefixItems": [
            {
              "$ref": "#/$defs/paragraph"
            }
          ],
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/paragraph"
              },
              {
                "$ref": "#/$defs/list"
              }
            ]
          },
          "contains": {
            "$ref": "#/$defs/paragraph"
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "image",
        "caption",
        "source"
      ],
      "properties": {
        "type": {
          "const": "figure"
        },
        "id": {
          "$ref": "#/$defs/target_id"
        },
        "image": {
          "$ref": "#/$defs/image_ref"
        },
        "caption": {
          "$ref": "#/$defs/inline_array"
        },
        "source": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/source_paragraphs"
            }
          ]
        }
      }
    },
    "image_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "alt",
        "title"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "not": {
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
              }
            },
            {
              "not": {
                "pattern": "^/"
              }
            },
            {
              "not": {
                "pattern": "[\\\\\\u0000-\\u001F\\u007F]"
              }
            }
          ]
        },
        "alt": {
          "$ref": "#/$defs/inline_array_allow_empty"
        },
        "title": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "[\\u0000-\\u001F\\u007F]"
              }
            }
          ]
        }
      }
    },
    "inline": {
      "oneOf": [
        {
          "$ref": "#/$defs/cross_reference"
        },
        {
          "$ref": "#/$defs/footnote"
        },
        {
          "$ref": "#/$defs/text"
        },
        {
          "$ref": "#/$defs/space"
        },
        {
          "$ref": "#/$defs/line_break"
        },
        {
          "$ref": "#/$defs/strong"
        },
        {
          "$ref": "#/$defs/emph"
        },
        {
          "$ref": "#/$defs/link"
        }
      ]
    },
    "target_id": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "[\\s#\\u0000-\\u001f\\u007f-\\u009f]"
      },
      "description": "Exact Unicode target identifier; no whitespace, controls or fragment separator. Target kind follows its heading, figure or table block."
    },
    "cross_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "kind",
        "target"
      ],
      "properties": {
        "type": {
          "const": "cross_reference"
        },
        "kind": {
          "enum": [
            "heading_number",
            "figure_number",
            "table_number"
          ]
        },
        "target": {
          "$ref": "#/$defs/target_id"
        }
      },
      "$comment": "References are allowed in document paragraphs, headings, list paragraphs, table cells, figure alt/caption, table captions, object sources and footnote bodies, including formatting/link labels. Semantic validation checks global ID uniqueness, target existence and matching kind."
    },
    "footnote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "blocks"
      ],
      "properties": {
        "type": {
          "const": "footnote"
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/paragraph"
          }
        }
      },
      "$comment": "Footnotes are permitted in document paragraphs, headings list paragraphs and table cells. Nested footnotes and notes in figure alt/caption or object sources are rejected by semantic validation."
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^ \\r\\n]+$",
          "not": {
            "pattern": "[ \\u0000-\\u001F\\u007F]"
          }
        }
      }
    },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "space"
        }
      }
    },
    "line_break": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "line_break"
        }
      }
    },
    "strong": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "inlines"
      ],
      "properties": {
        "type": {
          "const": "strong"
        },
        "inlines": {
          "$ref": "#/$defs/inline_array"
        }
      }
    },
    "emph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "inlines"
      ],
      "properties": {
        "type": {
          "const": "emph"
        },
        "inlines": {
          "$ref": "#/$defs/inline_array"
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "target",
        "title",
        "inlines"
      ],
      "properties": {
        "type": {
          "const": "link"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "[\\u0000-\\u001F\\u007F]"
          }
        },
        "title": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "[\\u0000-\\u001F\\u007F]"
              }
            }
          ]
        },
        "inlines": {
          "$ref": "#/$defs/inline_array"
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "columns",
        "header",
        "rows",
        "caption",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/target_id"
        },
        "type": {
          "const": "table"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "default",
              "left",
              "center",
              "right"
            ]
          }
        },
        "header": {
          "$ref": "#/$defs/table_row"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/table_row"
          }
        },
        "caption": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/inline_array"
            }
          ]
        },
        "source": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/source_paragraphs"
            }
          ]
        }
      }
    },
    "table_row": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/inline_array_allow_empty"
      }
    },
    "source_paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefix",
        "inlines"
      ],
      "properties": {
        "prefix": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:(?:출처|주|주석|참고|자료|설명|비고|단위|기준|해설|약어|참조|주의|작성|제공|재구성|번역|[sS][oO][uU][rR][cC][eE]|[sS][rR][cC]|[nN][oO][tT][eE]|[aA][nN][nN][oO][tT][aA][tT][iI][oO][nN]|[aA][nN][nN][oO][tT]|[rR][eE][fF][eE][rR][eE][nN][cC][eE]|[rR][eE][fF]|[dD][aA][tT][aA]|[dD][eE][sS][cC][rR][iI][pP][tT][iI][oO][nN]|[dD][eE][sS][cC]|[rR][eE][mM][aA][rR][kK]|[rR][eE][mM][aA][rR][kK][sS]|[uU][nN][iI][tT]|[bB][aA][sS][iI][sS]|[cC][oO][mM][mM][eE][nN][tT][aA][rR][yY]|[cC][mM][tT]|[aA][bB][bB][rR][eE][vV][iI][aA][tT][iI][oO][nN]|[aA][bB][bB][rR]|[cC][rR][eE][dD][iI][tT]|[tT][rR][aA][nN][sS][lL][aA][tT][iI][oO][nN]|[tT][rR][aA][nN][sS])\\.?|(?:주|주석|[nN][oO][tT][eE])\\.?[0-9]+)$",
          "description": "Recognized label without colon; English comparison is ASCII case-insensitive; original spelling retained. Semantic validation checks case-insensitively."
        },
        "inlines": {
          "$ref": "#/$defs/inline_array"
        }
      }
    },
    "source_paragraphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source_paragraph"
      }
    }
  }
}
