{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md2hwp.local/schemas/dependencies-lock-v0.1.schema.json",
  "title": "md2hwp dependencies lock v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "lock_version",
    "dependencies"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "const": "md2hwp.dependencies-lock"
    },
    "lock_version": {
      "const": "0.1"
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    }
  },
  "$defs": {
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "consumer", "pins"],
      "properties": {
        "name": {
          "$ref": "#/$defs/kebabName"
        },
        "consumer": {
          "type": "string",
          "minLength": 1
        },
        "pins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/systemReferencePin"
              },
              {
                "$ref": "#/$defs/contentPin"
              },
              {
                "$ref": "#/$defs/releaseArtifactPin"
              },
              {
                "$ref": "#/$defs/gitSubmodulePin"
              }
            ]
          }
        }
      }
    },
    "kebabName": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "systemReferencePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "version", "identifier"],
      "properties": {
        "name": {
          "$ref": "#/$defs/kebabName"
        },
        "kind": {
          "const": "system-reference"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "contentPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "url", "sha256"],
      "properties": {
        "name": {
          "$ref": "#/$defs/kebabName"
        },
        "kind": {
          "const": "content"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "releaseArtifactPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "version", "platform", "url", "sha256"],
      "properties": {
        "name": {
          "$ref": "#/$defs/kebabName"
        },
        "kind": {
          "const": "release-artifact"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "gitSubmodulePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "repository", "revision", "path"],
      "properties": {
        "name": {
          "$ref": "#/$defs/kebabName"
        },
        "kind": {
          "const": "git-submodule"
        },
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "pattern": "^upstream/[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    }
  }
}
